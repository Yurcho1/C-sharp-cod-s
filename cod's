// бой игрока в врага
int PlayerHealth = 70;
int PlayerDamage = 20;
int PlayerArmor = 7;
int PlayerCritChance = 22;

int EnemyHealht = 62;
int EnemyDamage = 19;
int EnemyArmor = 9;
int EnemyCritChance = 27;

Console.WriteLine("--- БИТВА НАЧИНАЕТСЯ ---");
Console.WriteLine($"Игрок : {PlayerHealth} HP, Броня {PlayerArmor}");
Console.WriteLine($"Враг : {EnemyHealht} HP, Броня {EnemyArmor}\n");

while (PlayerHealth > 0 && EnemyHealht > 0)
{
    int TotalDamagePlayer = Math.Max(0, EnemyDamage - PlayerArmor);
    int TotalDamageEnemy = Math.Max(0, PlayerDamage - EnemyArmor);

    PlayerHealth -= TotalDamagePlayer;
    EnemyHealht -= TotalDamageEnemy;
    Console.WriteLine($"Игрок получил {TotalDamagePlayer} урона, Осталось : {PlayerHealth} HP");
    Console.WriteLine($"Враг получил {TotalDamageEnemy} урона, Осталось : {EnemyHealht} HP");
}

Console.WriteLine("\n--- ИТОГ БОЯ ---\n");

if (PlayerHealth <= 0 && EnemyHealht <= 0)
{
    Console.WriteLine("Ничья");
}

else if (PlayerHealth >= 0)
{
    Console.WriteLine($"Победил игрок, осталось здоровья {PlayerHealth}");
}
else if (EnemyHealht >= 0)
{
    Console.WriteLine($"Победил враг, осталось здоовья {EnemyHealht}");
}
