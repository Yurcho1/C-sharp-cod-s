//Расчет будущей суммы под процент годовых
float money; //Ввод суммы пользователя

int years; //Длина вклада

float procent;

float summ;

Console.Write("Введите количесвто денег, внесенных на вклад : ");
money = float.Parse(Console.ReadLine());
Console.Write("\nНа сколько лет открыт вклад : ");
years = int.Parse(Console.ReadLine());
Console.Write("\nПод какой процент : ");
procent = float.Parse(Console.ReadLine());

for (int i = 1; i <= years; i++)
{
    summ = money / 100 * procent;
    money += summ;
    Console.WriteLine($"За {i} году у вас : {summ}");
    Console.ReadKey();
}

