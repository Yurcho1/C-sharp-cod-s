// Обменник валют 
float RublesInWallet; //Рубли в кошельке
float DollarsInWallet; //Доллары в кошкльке
float EuroInWallet; //евро в кошельке

int RublesToUsd = 82, UsdToRubles = 84, EuroToRub = 96, EuroToUsd = 1;

float num; // Переменная в которой хранится сумма которую хочет обменять п ользователь 

string DiseredOperation; //Желаемая операция 

Console.WriteLine("Добро пожаловать в обменник валют!\n");
Console.Write("Введите баланс рублей : ");
RublesInWallet = float.Parse(Console.ReadLine());

Console.Write("Введите баланс Долларов : ");
DollarsInWallet = float.Parse(Console.ReadLine());

Console.Write("Введите баланс евро : ");
EuroInWallet = float.Parse(Console.ReadLine());

Console.WriteLine("\nВыберите необходимую операцию : ");
Console.WriteLine("\n1 - Обменять рубли на доллары ");
Console.WriteLine("2 - Обменять доллары на рубли");
Console.WriteLine("3 - Обменять евро на рубли");
Console.WriteLine("4 - Обменять евро на доллары");
Console.Write("Ваш выбор : ");
DiseredOperation = Console.ReadLine();

switch (DiseredOperation)
{
    case "1":
        Console.Write("\nОбмен рублей на доллары ");
        Console.Write("\nСколько вы хотите обменять : ");
        num = float.Parse(Console.ReadLine());
        if (RublesInWallet >= num)
        {
            RublesInWallet -= num;
            DollarsInWallet += num / RublesToUsd;
        }
        else
        {
            Console.WriteLine("Недопустимое количество рублей");
        }
        break;
    case "2":
        Console.WriteLine("\nОбмен долларов на рубли ");
        Console.WriteLine("\nСколько вы хотите обменять : ");
        num = float.Parse(Console.ReadLine());
        if (DollarsInWallet >= num)
        {
            DollarsInWallet -= num;
            RublesInWallet += num * UsdToRubles;
        }
        else
        {
            Console.WriteLine("Недопустимое количество Долларов");
        }
        break;
    case "3":
        Console.WriteLine("\nОбмен евро на рубли ");
        Console.Write("\n Сколько вы хотите обменять : ");
        num = float.Parse(Console.ReadLine());
        if (EuroInWallet >= num)
        {
            EuroInWallet -= num;
            RublesInWallet += num * EuroToRub;
        }
        else
        {
            Console.WriteLine("Недопустимое число евро");
        }
        break;
    case "4":
        Console.WriteLine("\nОбмен евро на доллары ");
        Console.Write("\n Сколько вы хотите обменять : ");
        num = float.Parse(Console.ReadLine());
        if (EuroInWallet >= num)
        {
            EuroInWallet -= num;
            DollarsInWallet += num * EuroToUsd;
        }
        else
        {
            Console.WriteLine("Недопустимое число евро");
        }
        break;
    default:
        Console.WriteLine("Такой операции не существует");
        break;
}
Console.WriteLine($"Ваш баланс {RublesInWallet} рублей, " + $"{DollarsInWallet} долларов, " + $"{EuroInWallet} Евро");

